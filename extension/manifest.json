{
  "manifest_version": 3,
  "name": "InfinityLov",
  "version": "6.0.0",
  "description": "InfinityLov — créditos inteligentes no Lovable (membros + extensão).",
  "permissions": [
    "storage",
    "cookies",
    "activeTab",
    "tabs",
    "scripting",
    "alarms",
    "sidePanel",
    "offscreen",
    "webRequest",
    "webRequestBody"
  ],
  "host_permissions": [
    "https://lovable.dev/*",
    "https://*.lovable.dev/*",
    "https://api.lovable.dev/*",
    "https://lovable-api.com/*",
    "https://saxxqxkhyakqvfcjbkqa.supabase.co/*",
    "https://*.supabase.co/*",
    "https://text.pollinations.ai/*",
    "https://generativelanguage.googleapis.com/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["https://lovable.dev/*"],
      "js": ["content/inject.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://lovable.dev/*"],
      "js": ["content/content.js"],
      "css": ["content/content.css"],
      "run_at": "document_start"
    }
  ],
  "action": {
    "default_title": "InfinityLov",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "remote-ui.js",
        "jszip.min.js",
        "popup.html",
        "popup.js",
        "icons/*",
        "logo.png",
        "banner.png"
      ],
      "matches": ["<all_urls>"]
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; frame-src blob: https://saxxqxkhyakqvfcjbkqa.supabase.co;"
  },
  "commands": {
    "toggle-enabled": {
      "suggested_key": {
        "default": "Ctrl+Shift+L",
        "mac": "Command+Shift+L"
      },
      "description": "Alternar InfinityLov"
    }
  }
}
